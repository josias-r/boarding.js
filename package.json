{
  "name": "boarding.js",
  "version": "4.0.2",
  "private": false,
  "keywords": [
    "feature-introductions",
    "focus-shifters",
    "intro",
    "onboarding",
    "overlay",
    "overlays",
    "popover",
    "spotlight",
    "tour",
    "user-onboarding",
    "walkthrough"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/josias-r/boarding.js.git"
  },
  "files": [
    "dist",
    "styles"
  ],
  "type": "module",
  "main": "dist/main.mjs",
  "types": "dist/main.d.mts",
  "exports": {
    ".": {
      "types": "./dist/main.d.mts",
      "import": "./dist/main.mjs"
    },
    "./styles/main.css": "./styles/main.css",
    "./styles/themes/basic.css": "./styles/themes/basic.css"
  },
  "scripts": {
    "dev": "node scripts/serve.js",
    "build": "tsdown",
    "test": "playwright test",
    "lint": "oxlint src tests",
    "format": "oxfmt",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "tsdown": "0.23.3",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61"
}
